# CodeInsight AI - Environment Configuration
# Copy this file to ".env" in the backend/ folder and fill in real values.
# NEVER commit the real .env file.

# ---- General ----
DATA_DIR=./data
WORKSPACE_DIR=./data/repos

# ---- LLM Provider: anthropic | openai | mock ----
# "mock" requires no API key and lets you demo the full pipeline offline.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=800

# ---- Embeddings: local (sentence-transformers, no key needed) | openai ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Vector store ----
VECTOR_STORE_DIR=./data/vector_store

# ---- Knowledge graph: neo4j | networkx ----
# "networkx" runs fully in-process with no external database (good for a
# quick demo). "neo4j" requires a running Neo4j instance (see docker-compose.yml).
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace_with_your_own_password

# ---- Chunking ----
CHUNK_MAX_LINES=60
CHUNK_OVERLAP_LINES=5

# ---- Retrieval ----
TOP_K_VECTOR=6
GRAPH_HOPS=2

# ---- Server ----
HOST=0.0.0.0
PORT=8000
